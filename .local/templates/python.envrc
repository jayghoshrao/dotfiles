#!/bin/zsh
# # For nix (flake) based devshells
# use flake . --impure
# eval "$shellHook"

# -----------------
# Utility functions
# -----------------
msg() {
  echo >&2 -e "${1-}"
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  msg "$msg"
  exit "$code"
}

# Detect minimum Python version from project setup files.
# Checks pyproject.toml (requires-python), setup.cfg, and setup.py (python_requires).
# Extracts the first version after >=, ==, or ~= specifiers.
detect_python_version() {
    local dir="${1:-$PWD}"
    local version=""

    if [[ -f "$dir/pyproject.toml" ]]; then
        version=$(grep -m1 'requires-python' "$dir/pyproject.toml" | grep -oP '(?:>=|==|~=)\K\d+\.\d+' | head -1)
    fi

    if [[ -z "$version" && -f "$dir/setup.cfg" ]]; then
        version=$(grep -m1 'python_requires' "$dir/setup.cfg" | grep -oP '(?:>=|==|~=)\K\d+\.\d+' | head -1)
    fi

    if [[ -z "$version" && -f "$dir/setup.py" ]]; then
        version=$(grep -m1 'python_requires' "$dir/setup.py" | grep -oP '(?:>=|==|~=)\K\d+\.\d+' | head -1)
    fi

    echo "$version"
}

# Atomic lock: spin-wait on a noclobber lock file, clear stale locks by PID check.
_acquire_lock() {
    local lockfile="$1"
    local timeout="${2:-120}"
    local elapsed=0
    while ! (set -o noclobber; echo $$ > "$lockfile") 2>/dev/null; do
        local pid
        pid=$(cat "$lockfile" 2>/dev/null)
        if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$lockfile"
            continue
        fi
        if (( elapsed >= timeout )); then
            msg "Timed out waiting for environment setup lock"; return 1
        fi
        msg "Environment setup in progress (pid ${pid:-?}), waiting..."
        sleep 2; (( elapsed += 2 ))
    done
}

_release_lock() {
    local lockfile="$1"
    local pid
    pid=$(cat "$lockfile" 2>/dev/null)
    [[ "$pid" == "$$" ]] && rm -f "$lockfile"
}

# shortcut for creating new conda environments
mamba_new_env() {
    mamba create -n $1 -y python=$PYTHON_VERSION
    mamba activate $1       # or source $MINICONDA3_PATH/bin/activate $1
    if [ -f "$DIR_PATH/requirements.txt" ]; then
        mamba install -c conda-forge -y --file "$DIR_PATH/requirements.txt"
        if [[ "$?" != 0 ]]; then
            echo "Mamba failed. Trying pip..."
            pip install -r "$DIR_PATH/requirements.txt"
        fi
    fi
}

pip_new_env() {
    _acquire_lock "$LOCK_FILE" || return 1
    python -m venv .venv
    source .venv/bin/activate
    echo "Created env with $(python --version)"
    if [ -f "$DIR_PATH/requirements.txt" ]; then
        pip install -r "$DIR_PATH/requirements.txt"
    fi
    _release_lock "$LOCK_FILE"
}

# -------
# Globals
# -------
DIR_PATH="$PWD"
PYTHON_VERSION=3.11  # fallback; auto-detected from project setup files below
ENV_NAME=
LOCK_FILE=
VENV_ROOT=$HOME/local/venv

# Tell if the script is run or sourced
(
  [[ -n $ZSH_VERSION && $ZSH_EVAL_CONTEXT =~ :file$ ]] || 
  [[ -n $KSH_VERSION && "$(cd -- "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")" != "$(cd -- "$(dirname -- "${.sh.file}")" && pwd -P)/$(basename -- "${.sh.file}")" ]] || 
  [[ -n $BASH_VERSION ]] && (return 0 2>/dev/null)
) && SOURCED=1 || SOURCED=0

if [[ "$SOURCED" == 1 ]]; then
    if [[ -n "$BASH_SOURCE" ]]; then
        # Sourced via direnv or scripts
        DIR_PATH=$(dirname -- "$(realpath "$BASH_SOURCE")")
    elif [[ -n "$@" ]]; then 
        # probably not needed
        DIR_PATH=$(dirname -- "$(readlink -f -- $1)")
    else
        # Sourced manually
        DIR_PATH=$(dirname -- "$(readlink -f -- $0)")
    fi
    _detected_version=$(detect_python_version "$DIR_PATH")
    [[ -n "$_detected_version" ]] && PYTHON_VERSION="$_detected_version"
    unset _detected_version
    ENV_NAME="$(basename "$DIR_PATH")-$PYTHON_VERSION"
    LOCK_FILE="${DIR_PATH}/.envrc.lock"
elif [[ "$SOURCED" == 0 ]]; then
    die "Running this script is useless. Please source it!"
fi

# --------------------------
# uv/pyenv/conda/mamba
# --------------------------
if hash uv > /dev/null 2>&1; then
    if [[ ! -d "${DIR_PATH}/.venv" ]]; then
        _acquire_lock "$LOCK_FILE" || return 1
        if [[ ! -d "${DIR_PATH}/.venv" ]]; then
            cd "$DIR_PATH"
            uv venv --python $PYTHON_VERSION --seed --project "$DIR_PATH"
            cd -
            source "$DIR_PATH/.venv/bin/activate"
            [[ -f "${DIR_PATH}/requirements.txt" ]] && uv pip install -r "${DIR_PATH}/requirements.txt"
            uv pip install -e "${DIR_PATH}"
        fi
        _release_lock "$LOCK_FILE"
    fi
    source "$DIR_PATH/.venv/bin/activate"
elif hash pyenv > /dev/null 2>&1; then
    # curl https://pyenv.run | bash
    # pacman -S --needed base-devel openssl zlib xz tk
    if ! pyenv versions | grep -q $PYTHON_VERSION || ! pyenv virtualenvs | grep -q $ENV_NAME; then
        _acquire_lock "$LOCK_FILE" || return 1
        if ! pyenv versions | grep -q $PYTHON_VERSION; then
            pyenv install $PYTHON_VERSION
        fi
        if ! pyenv virtualenvs | grep -q $ENV_NAME; then
            pyenv virtualenv "$PYTHON_VERSION" "$ENV_NAME"
            pyenv activate "$ENV_NAME"
            pip install --require-virtualenv setuptools
            pip install --require-virtualenv -r "${DIR_PATH}/requirements.txt"
            # TODO: If install fails, delete env?
        fi
        _release_lock "$LOCK_FILE"
    fi
    pyenv activate "$ENV_NAME"
elif hash conda > /dev/null 2>&1; then
    [ -n "$CONDA_EXE" ] && MINICONDA3_PATH="${CONDA_EXE%%/bin/conda}" || msg "Could not find conda install path!" && return
    SHELLNAME=$(basename $SHELL)
    [[ "$SHELLNAME" == "bash" ]] || [[ "$SHELLNAME" == "zsh" ]] || msg "unknown shell: $SHELL" && return

    __conda_setup="$( $MINICONDA3_PATH/bin/conda 'shell.'$SHELLNAME 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "$MINICONDA3_PATH/etc/profile.d/conda.sh" ]; then
            . "$MINICONDA3_PATH/etc/profile.d/conda.sh"
        else
            export PATH="$MINICONDA3_PATH/bin:$PATH"
        fi
    fi
    unset __conda_setup

    if [ -f "$MINICONDA3_PATH/etc/profile.d/mamba.sh" ]; then
        . "$MINICONDA3_PATH/etc/profile.d/mamba.sh"
    fi

    # Activate or create mamba environment
    if ! conda env list | grep -qE "^${ENV_NAME}\s"; then
        _acquire_lock "$LOCK_FILE" || return 1
        if ! conda env list | grep -qE "^${ENV_NAME}\s"; then
            mamba_new_env "$ENV_NAME"
        fi
        _release_lock "$LOCK_FILE"
    fi
    mamba activate "$ENV_NAME"
else
    # Activate or create venv environment
    [[ -d "$DIR_PATH/.venv" ]] && source "$DIR_PATH/.venv/bin/activate" || pip_new_env
    export VIRTUAL_ENV="$ENV_NAME"
fi

# Export Env Vars
# export PYTHONPATH=$DIR_PATH:$PYTHONPATH
export PYTHONPATH=$DIR_PATH
export PATH=$DIR_PATH/bin:$PATH
