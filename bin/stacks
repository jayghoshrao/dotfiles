#!/usr/bin/env bash

set -u

if [[ -n "${STACKS_ROOT:-}" ]]; then
    :
elif [[ -d "$HOME/docker" ]]; then
    STACKS_ROOT="$HOME/docker"
elif [[ -d "/opt/docker" ]]; then
    STACKS_ROOT="/opt/docker"
else
    echo "ERROR: STACKS_ROOT not set and neither $HOME/docker nor /opt/docker exist" >&2
    exit 1
fi

STACKS=( $(find "${STACKS_ROOT}" -maxdepth 2 -name "docker-compose.yml" \
  -not -path "*/__staging__/*" \
  -exec dirname {} \; | xargs -n1 basename | sort) )

function die() { echo -e "ERROR: $@" >&2; exit -1; }
function ensure_command() { [[ -x $(command -v "$1") ]] || die "no such command: ${1}"; }
function check_command() { [[ -x $(command -v "$1") ]] && return 0 || return -1; }
function ensure_dir() { [[ -d "$1" ]] || die "Dir not found: $1"; }
function ensure_file() { [[ -f "$1" ]] || die "File not found: $1"; }
function check_file() { [[ -f "$1" ]] && return 0 || return -1; }
function check_dir() { [[ -d "$1" ]] && return 0 || return -1; }

# All requirements: docker find gpg jq 

function bootstrap()
{
    echo -e "\033[1;31mBOOTSTRAPPING WILL OVERWRITE EXISTING VOLUMES!\033[0m"
    local RESPONSE=""
    read -p "Are you sure? [y/n]" -e -i "$RESPONSE" RESPONSE

    [[ "$RESPONSE" == 'y' ]] || exit 0

    # TODO: Decrypt secrets
    ensure git-crypt
    git crypt unlock

    create_network
    run_command_all up -d
    run_command_all down
    ## TODO: Ensure that volumes are created

    ## Restore volumes
    ## Restores to /volumes, where all the volumes should be properly mounted
    stack utils run --build --rm backup restic restore --path /volumes --target /  latest

    ## Restore immich data
    ## Restores to /data, where all the data should be mounted
    stack utils run --build --rm backup restic restore --path /data --target / --include /data/Media/Immich latest

    ## Restore other data if necessary
    ## ---

    run_command_all up -d
    check
}

function cache() 
{
    # WARNING: Only works with running containers
    ensure_command jq
    mkdir -p "${STACKS_ROOT}/.cache"
    for STACK in ${STACKS[@]}; do 
        local COMPOSE_FILE="${STACKS_ROOT}/${STACK}/docker-compose.yml"
        ensure_file "${COMPOSE_FILE}"
        docker compose -f "${COMPOSE_FILE}" images --format json | jq -r '.[].ID' | xargs -I{} docker inspect {} --format json | jq -r '.[] | {tag: (.RepoTags | if (.| length > 0) then .[0] else null end) , digest:.RepoDigests[], version:.Config.Labels."org.opencontainers.image.version", title:.Config.Labels."org.opencontainers.image.title", description:.Config.Labels."org.opencontainers.image.description", source:.Config.Labels."org.opencontainers.image.source"}' >> "${STACKS_ROOT}/.cache/${DATETIME}.json"
    done
}

function run_command_all()
{
    ensure_command stack
    for STACK in ${STACKS[@]}; do 
        stack ${STACK} "$@"
    done
}

function create_network()
{
    OUT=$(docker network list --filter name=default_network --format "{{.Name}}")
    [[ "$OUT" == "default_network" ]] || docker network create default_network
}

function rsync_backup_stacks()
{
	rsync -avzhrcP \
		--delete \
		--log-file=${HOME}/local/logs/docker-stack-backup/${DATETIME}.log \
		${STACKS_ROOT}/ \
		${HOME}/HDD/Storage/Backup-Bhumi/docker
}

function rclone_backup_stacks()
{
    ensure_command stack
    ensure_file ${HOME}/.config/rclone/rclone.conf
    mkdir -p ${HOME}/local/logs

    REMOTES=($(rclone listremotes))
    TARGET_REMOTE="frostheim-encrypted:"
    TARGET_PATH="${HOST}/docker"

    [[ " ${REMOTES[@]} " =~ " ${TARGET_REMOTE} " ]] || die "Could not find target rclone remote: ${TARGET_REMOTE}"

    STACKS_ROOT_MOUNT="/opt/stacks"
    stack utils run --rm --build backup rclone sync "${STACKS_ROOT_MOUNT}" "${TARGET_REMOTE}${TARGET_PATH}"
}

function rclone_backup_volumes()
{
    ensure_command stack
    ensure_file ${HOME}/.config/rclone/rclone.conf
    mkdir -p ${HOME}/local/logs

    REMOTES=($(rclone listremotes))
    TARGET_REMOTE="frostheim-encrypted:"
    TARGET_PATH="${HOST}/docker-volumes"

    [[ " ${REMOTES[@]} " =~ " ${TARGET_REMOTE} " ]] || die "Could not find target rclone remote: ${TARGET_REMOTE}"

    run_command_all down
    stack utils run --rm --build backup rclone sync /volumes/ "${TARGET_REMOTE}${TARGET_PATH}" 
    run_command_all up -d
}

function restic_backup_volumes()
{
    ensure_command stack
    run_command_all down
    stack utils run --rm --build backup restic backup /volumes
    run_command_all up -d
}

function restic_backup_data()
{
    stack utils run --rm --build backup restic backup --exclude-file /data/restic-backup-excludes.txt /data 
}

function restic_backup_stacks()
{
    stack utils run --rm --build backup restic backup /opt
}

function restic_prune()
{
    stack utils run --rm --build backup restic forget --keep-daily 10 --keep-weekly 12 --keep-monthly 6 --prune
}

function restic_list_snapshots()
{
    ensure_command stack
    local VOL_NAME="${1:-}"
    if [[ -n "${VOL_NAME}" ]]; then
        stack utils run --rm backup restic snapshots --path "/volumes/${VOL_NAME}"
    else
        stack utils run --rm backup restic snapshots
    fi
}

function restic_restore_volume()
{
    ensure_command stack
    local STACK_NAME="${1:-}"
    local VOL_SHORT_NAME="${2:-}"
    local SNAPSHOT="${3:-latest}"

    [[ -n "${STACK_NAME}" ]] || die "Usage: restic_restore_volume <stack> [<volume>] [<snapshot_id|latest|list>]"

    local COMPOSE_FILE="${STACKS_ROOT}/${STACK_NAME}/docker-compose.yml"
    ensure_file "${COMPOSE_FILE}"

    local YQ_CMD=yq
    check_command yq || YQ_CMD="docker run --rm -v ${STACKS_ROOT}:${STACKS_ROOT} nixery.dev/yq yq"

    local PROJECT_NAME
    PROJECT_NAME=$(${YQ_CMD} -r '.name' "${COMPOSE_FILE}" 2>/dev/null)
    [[ -n "${PROJECT_NAME}" ]] || PROJECT_NAME=$(basename "${STACKS_ROOT}/${STACK_NAME}")

    if [[ -z "${VOL_SHORT_NAME}" ]]; then
        local VOLUMES=( $(${YQ_CMD} -r '.volumes | keys[]' "${COMPOSE_FILE}" 2>/dev/null) )
        echo "Available volumes for stack '${STACK_NAME}' (project: ${PROJECT_NAME}):"
        for vol in "${VOLUMES[@]}"; do
            echo "  ${PROJECT_NAME}_${vol}"
        done
        echo ""
        echo "Usage: stacks restic_restore_volume ${STACK_NAME} <volume> [snapshot_id|list]"
        return
    fi

    local FULL_VOL_NAME
    if [[ "${VOL_SHORT_NAME}" == "${PROJECT_NAME}_"* ]]; then
        FULL_VOL_NAME="${VOL_SHORT_NAME}"
    else
        FULL_VOL_NAME="${PROJECT_NAME}_${VOL_SHORT_NAME}"
    fi

    docker volume inspect "${FULL_VOL_NAME}" &>/dev/null || die "Volume not found: ${FULL_VOL_NAME}"

    if [[ "${SNAPSHOT}" == "list" ]]; then
        echo "Snapshots containing /volumes/${FULL_VOL_NAME}:"
        stack utils run --rm backup restic snapshots --path "/volumes/${FULL_VOL_NAME}"
        return
    fi

    echo "Will restore: /volumes/${FULL_VOL_NAME}"
    echo "From snapshot: ${SNAPSHOT}"
    echo "Stack '${STACK_NAME}' will be brought down and back up."
    local CONFIRM=""
    read -p "Proceed? [y/N] " -r CONFIRM
    [[ "${CONFIRM}" == "y" ]] || { echo "Aborted."; return; }

    stack "${STACK_NAME}" down
    stack utils run --rm --build backup restic restore "${SNAPSHOT}" --target / --include "/volumes/${FULL_VOL_NAME}"
    stack "${STACK_NAME}" up -d
}

function check()
{
    for STACK in ${STACKS[@]}; do 
        local COMPOSE_FILE="${STACKS_ROOT}/${STACK}/docker-compose.yml"
        ensure_file "${COMPOSE_FILE}"
        OUT=$(docker compose -f "${COMPOSE_FILE}" ps --all --format "#{{.State}}# {{.Project}}/{{.Service}}" | sed -e 's/#running#/🟢/' | sed -r 's/#[a-z]+#/🔴/')
        if [ -n "$OUT" ]; then
            echo -e "$OUT"
        else
            echo "🔴 ${STACK}"
        fi
    done
}

function list()
{
    for STACK in ${STACKS[@]}; do 
        echo "${STACK}"
    done

}

function list_volumes()
{
    ## NOTE: Only works on running containers
    echo -e "WARN: Only shows volumes attached to running containers\n"
    IGNORED_CONTAINERS_MATCHERS=( komodo backup redis )
    IGNORED_VOLUMES_MATCHERS=( immich_model-cache redis )
    IFS=$'|'
    IGNORED_CONTAINERS_GREPSTR="${IGNORED_CONTAINERS_MATCHERS[*]}"
    IGNORED_VOLUMES_GREPSTR="${IGNORED_VOLUMES_MATCHERS[*]}"

    docker ps -a --format '{{ .ID }} {{.Names}}' | grep -vE "$IGNORED_CONTAINERS_GREPSTR" | awk '{print $1}' | xargs docker inspect '--format={{json .Mounts}}' | jq -r '.[] | select(.Type == "volume") | .Name' |  sort | uniq | grep -vE "$IGNORED_VOLUMES_GREPSTR"
}

function dump_volumes()
{
    local TARGET_STACKS=("$@")
    [[ ${#TARGET_STACKS[@]} -gt 0 ]] || TARGET_STACKS=("${STACKS[@]}")

    local OUTPUT_DIR="${STACKS_ROOT}/__dumped_volumes__/${DATETIME}"
    mkdir -p "${OUTPUT_DIR}"
    echo "Dumping volumes to: ${OUTPUT_DIR}"

    local YQ_CMD=yq
    check_command yq || YQ_CMD="docker run --rm -v ${STACKS_ROOT}:${STACKS_ROOT} nixery.dev/yq yq"

    for STACK in "${TARGET_STACKS[@]}"; do
        local COMPOSE_FILE="${STACKS_ROOT}/${STACK}/docker-compose.yml"
        ensure_file "${COMPOSE_FILE}"

        local PROJECT_NAME
        PROJECT_NAME=$(${YQ_CMD} -r '.name' "${COMPOSE_FILE}" 2>/dev/null)
        [[ -n "${PROJECT_NAME}" ]] || PROJECT_NAME=$(basename "${STACKS_ROOT}/${STACK}")

        local VOLUMES=()
        mapfile -t VOLUMES < <(${YQ_CMD} -r '.volumes | keys[]' "${COMPOSE_FILE}" 2>/dev/null)

        if [[ ${#VOLUMES[@]} -eq 0 ]]; then
            echo "No volumes found for stack '${STACK}', skipping."
            continue
        fi

        local STACK_OUTPUT_DIR="${OUTPUT_DIR}/${STACK}"
        mkdir -p "${STACK_OUTPUT_DIR}"

        for vol in "${VOLUMES[@]}"; do
            local FULL_VOL_NAME="${PROJECT_NAME}_${vol}"

            if ! docker volume inspect "${FULL_VOL_NAME}" &>/dev/null; then
                echo "Volume ${FULL_VOL_NAME} not found, skipping."
                continue
            fi

            echo "Dumping volume: ${FULL_VOL_NAME}"
            docker run --rm \
                -v "${FULL_VOL_NAME}:/source:ro" \
                -v "${STACK_OUTPUT_DIR}:/backup" \
                alpine tar czf "/backup/${FULL_VOL_NAME}.tar.gz" -C /source .
        done
    done

    echo "Done. Volumes dumped to: ${OUTPUT_DIR}"
}

function list_dumps()
{
    local DUMPS_DIR="${STACKS_ROOT}/__dumped_volumes__"
    if [[ ! -d "${DUMPS_DIR}" ]]; then
        echo "No dumps found."
        return
    fi
    ls "${DUMPS_DIR}"
}

function restore_dumped_volumes()
{
    local DUMP_ID="${1:-}"
    [[ -n "${DUMP_ID}" ]] || die "Usage: stacks restore_dumped_volumes <datetime> [stack1 stack2 ...]"
    shift

    local DUMP_DIR="${STACKS_ROOT}/__dumped_volumes__/${DUMP_ID}"
    [[ -d "${DUMP_DIR}" ]] || die "Dump not found: ${DUMP_DIR}"

    local TARGET_STACKS=("$@")
    [[ ${#TARGET_STACKS[@]} -gt 0 ]] || TARGET_STACKS=("${STACKS[@]}")

    echo "Restoring volumes from: ${DUMP_DIR}"
    local CONFIRM=""
    read -p "This will overwrite existing volume data. Proceed? [y/N] " -r CONFIRM
    [[ "${CONFIRM}" == "y" ]] || { echo "Aborted."; return; }

    local YQ_CMD=yq
    check_command yq || YQ_CMD="docker run --rm -v ${STACKS_ROOT}:${STACKS_ROOT} nixery.dev/yq yq"

    for STACK in "${TARGET_STACKS[@]}"; do
        local STACK_DUMP_DIR="${DUMP_DIR}/${STACK}"
        if [[ ! -d "${STACK_DUMP_DIR}" ]]; then
            echo "No dump found for stack '${STACK}', skipping."
            continue
        fi

        local COMPOSE_FILE="${STACKS_ROOT}/${STACK}/docker-compose.yml"
        ensure_file "${COMPOSE_FILE}"

        local PROJECT_NAME
        PROJECT_NAME=$(${YQ_CMD} -r '.name' "${COMPOSE_FILE}" 2>/dev/null)
        [[ -n "${PROJECT_NAME}" ]] || PROJECT_NAME=$(basename "${STACKS_ROOT}/${STACK}")

        local VOLUMES=()
        mapfile -t VOLUMES < <(${YQ_CMD} -r '.volumes | keys[]' "${COMPOSE_FILE}" 2>/dev/null)

        stack "${STACK}" down

        for vol in "${VOLUMES[@]}"; do
            local FULL_VOL_NAME="${PROJECT_NAME}_${vol}"
            local ARCHIVE="${STACK_DUMP_DIR}/${FULL_VOL_NAME}.tar.gz"

            if [[ ! -f "${ARCHIVE}" ]]; then
                echo "No archive found for volume ${FULL_VOL_NAME}, skipping."
                continue
            fi

            docker volume inspect "${FULL_VOL_NAME}" &>/dev/null || docker volume create "${FULL_VOL_NAME}"

            echo "Restoring volume: ${FULL_VOL_NAME}"
            docker run --rm \
                -v "${FULL_VOL_NAME}:/target" \
                -v "${STACK_DUMP_DIR}:/backup:ro" \
                alpine sh -c "find /target -mindepth 1 -delete && tar xzf /backup/${FULL_VOL_NAME}.tar.gz -C /target"
        done

        stack "${STACK}" up -d
    done

    echo "Done."
}

function edit_crontab
{
    ensure_dir /etc/cron.d
    sudoedit /etc/cron.d/backups
}

ensure_command docker

HOST=$(hostnamectl --static)
DATETIME=$(date "+%Y-%m-%d_%H-%M-%S")
echo "STACKS_ROOT=${STACKS_ROOT}" >&2
ensure_dir "${STACKS_ROOT}"
cd "${STACKS_ROOT}" || die "could not cd into ${STACKS_ROOT}"


POSITIONAL=()
while [[ $# -gt 0 ]]
do
    key="$1"
    case $key in
        check)
            shift ; check ;;
        list)
            shift ; list ;;
        list_volumes)
            shift ; list_volumes ;;
        cache) 
            shift ; cache ;;
        net)
            shift ; create_network ;;
        edit)
            shift ; ${EDITOR} ${STACKS_ROOT} ; exit ;; 
        restic_backup_volumes)
            shift ; restic_backup_volumes ;; 
        restic_backup_data)
            shift ; restic_backup_data ;; 
        restic_backup_stacks)
            shift ; restic_backup_stacks ;; 
        rclone_backup_stacks)
            shift ; rclone_backup_stacks ;; 
        rclone_backup_volumes)
            shift ; rclone_backup_volumes;; 
        restic_prune)
            shift ; restic_prune ;;
        restic_list_snapshots)
            shift ; restic_list_snapshots "$@" ; exit ;;
        restic_restore_volume)
            shift ; restic_restore_volume "$@" ; exit ;;
        dump_volumes)
            shift ; dump_volumes "$@" ; exit ;;
        list_dumps)
            shift ; list_dumps ;;
        restore_dumped_volumes)
            shift ; restore_dumped_volumes "$@" ; exit ;;
        backupsh)
            shift ; stack utils run --rm --build backup bash ;;
        bootstrap)
            shift ; bootstrap ; exit ;;
        crontab)
            shift ; edit_crontab ; exit ;;
        down)
            shift ; run_command_all down ;; 
        up|build)
            create_network
            run_command_all "$@"
            exit ;;
        *) POSITIONAL+=("$1"); shift ;;
    esac
done
set -- "${POSITIONAL[@]}" # restore positional parameters

# [[ -n "$@" ]] || exit 0
# ensure_command stack
# stack "$@"
