#!/bin/bash

## dex: [d]ecrypt [e]ncrypt e[x]change
# RESOURCE: https://unix.stackexchange.com/questions/387993/how-to-run-a-pipe-safely-and-sequentially/388486#388486

# TODO: recursive  in folder
# TODO: encrypt if not, decrypt if not

msg() {
  echo >&2 -e "${1-}"
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  msg "$msg"
  exit "$code"
}

set -uo pipefail

MODE='EXCHANGE' ### or EDIT (-e)
ENCRYPT_NONEXIST=true

LOCKFOLDER="$HOME/.local/share/dex"
[ -d "$LOCKFOLDER" ] || mkdir -p "$LOCKFOLDER"

# LOCKFILE="$HOME/.local/share/dex.lock"

POSITIONAL=()
while [[ $# -gt 0 ]]
do
    key="$1"

    case $key in
        -E|--encrypt)
            MODE='ENCRYPT'
            shift ;;
        -D|--DECRYPT)
            MODE='DECRYPT'
            shift ;;
        -e|--edit)
            MODE='EDIT'
            shift ;;
        -u|--unlock)
            MODE="UNLOCK"
            shift ;;
        -n|--noencrypt-nonexist)
            ENCRYPT_NONEXIST=false
            shift ;;
        -p|--print)
            MODE='PRINT'
            shift ;;
        -clf|--clean-lockfiles)
            for FILE in "$LOCKFOLDER"/*; do
                [[ -f "$FILE" ]] || continue
                LOCK_STATUS=$(flock -n -x "$FILE" echo 'unlocked!')
                [[ -n "$LOCK_STATUS" ]] && rm "$FILE"
            done
            exit
            ;;
        --pager)
            MODE='PAGER'
            shift ;;
        -?*) 
            echo "Unknown option: $1"
            exit
            ;;
        *)    # unknown option
            POSITIONAL+=("$1") # save it in an array for later
            shift ;;
    esac
done
set -- "${POSITIONAL[@]}" # restore positional parameters

[[ $# -lt 1 ]] && die "Usage: dex [opts] <file>"

FILENAME="$1"
FILEPATH=$(realpath "$FILENAME")
FILEPATHENC=${FILEPATH//\//%}
LOCKFILE="$LOCKFOLDER/$FILEPATHENC"

VIPE_SUFFIX="$(basename "$FILENAME")"

typestr=$(file "$FILENAME")

if [[ "$MODE" == "EXCHANGE" ]]; then
    TMPFILE=$(mktemp)
    if [[ "$typestr" =~ "encrypted" ]]; then
        gpg -dq -o "$TMPFILE" "$FILENAME" && mv "$TMPFILE" "$FILENAME"
    else
        gpg -o "$TMPFILE" -e "$FILENAME" && mv "$TMPFILE" "$FILENAME"
    fi
    rm -f "$TMPFILE" 2>/dev/null
elif [[ "$MODE" == "PAGER" ]]; then
    if [[ "$typestr" =~ "encrypted" ]]; then 
        gpg -dq "$FILENAME" | less
    else
        less "$FILENAME"
    fi
elif [[ "$MODE" == "PRINT" ]]; then 
    if [[ "$typestr" =~ "encrypted" ]]; then 
        gpg -dq "$FILENAME"
    else
        cat "$FILENAME"
    fi
elif [[ "$MODE" == "UNLOCK" ]]; then
    rm -f "$LOCKFILE"
elif [[ "$MODE" == "EDIT" ]]; then
    if [[ "$typestr" =~ "encrypted" ]]; then
        # Uses lockfiles to ensure file is not multiply modified
        # NOTE: 9>&- closes fd 9 for child processes to prevent editors from inheriting the lock
        # Temp file avoids $() trailing-newline stripping and drops the vipe dependency
        ( flock -n 9 || die "Failure to acquire lockfile: $LOCKFILE."
        echo "Acquiring lock..."
        TMPFILE=$(mktemp --suffix=".${VIPE_SUFFIX}")
        gpg -dq -o "$TMPFILE" "$FILENAME" 9>&- && \
            ${EDITOR:-vi} "$TMPFILE" && \
            gpg -e --batch --yes -o "$FILENAME" < "$TMPFILE"
        shred -u "$TMPFILE" 2>/dev/null || rm -f "$TMPFILE"
        echo "Releasing lock..."
        ) 9>"$LOCKFILE"
    elif [ -f "$FILENAME" ]; then
        # If file exists and not encrypted
        ${EDITOR:-vi} "$FILENAME"
    else
        if ${ENCRYPT_NONEXIST}; then
            # if file doesn't exist, create and encrypt
            ( flock -n 9 || exit 1
            TMPFILE=$(mktemp --suffix=".${VIPE_SUFFIX}")
            ${EDITOR:-vi} "$TMPFILE" && gpg -e --batch --yes -o "$FILENAME" < "$TMPFILE"
            shred -u "$TMPFILE" 2>/dev/null || rm -f "$TMPFILE"
            ) 9>"$LOCKFILE"
        else
            ${EDITOR:-vi} "$FILENAME"
        fi
    fi
elif [[ "$MODE" == "ENCRYPT" ]]; then
    if [[ ! "$typestr" =~ "encrypted" ]]; then
        TMPFILE=$(mktemp)
        gpg -o "$TMPFILE" -e "$FILENAME" && mv "$TMPFILE" "$FILENAME"
        rm -f "$TMPFILE" 2>/dev/null
    fi
elif [[ "$MODE" == "DECRYPT" ]]; then
    if [[ "$typestr" =~ "encrypted" ]]; then
        TMPFILE=$(mktemp)
        gpg -dq -o "$TMPFILE" "$FILENAME" && mv "$TMPFILE" "$FILENAME"
        rm -f "$TMPFILE" 2>/dev/null
    fi
fi
